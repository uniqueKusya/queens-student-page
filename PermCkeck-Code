#PermCheck
def solution(A):
    n = len(A)
    seen = [False] * (n + 1)


    for x in A:
        # Reject if the value is outside the valid 1 to N range
        if x > n or x < 1:
            return 0
           
        # Reject if the value is a duplicate
        if seen[x]:
            return 0
           
        # Mark the valid value as seen
        seen[x] = True


    return 1




# Test
print(solution([4, 1, 3, 2]))  # prints 1
print(solution([4, 1, 3]))     # prints 0
