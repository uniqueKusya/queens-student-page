def solution(X, A):
    seen = [False] * (X + 1)
    covered = 0


    for time, x in enumerate(A):
        if not seen[x]:       # new position covered
            seen[x] = True
            covered += 1
            if covered == X:  # all positions 1..X are covered
                return time


    return -1




# Test
print(solution(5, [1, 3, 1, 4, 2, 3, 5, 4]))  # 6
print(solution(5, [1, 3, 1, 4, 2, 3, 4]))     # -1
