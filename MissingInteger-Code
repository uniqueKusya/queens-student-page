def solution(A):
    n = len(A)
    seen = [False] * (n + 2)

    for x in A:
        if 1 <= x <= n:   # only values that can matter
            seen[x] = True


    result = 1
    while seen[result]:   # find the first unmarked number
        result += 1

    return result

# Test
print(solution([1, 3, 6, 4, 1, 2]))  # 5
print(solution([1, 2, 3]))           # 4
print(solution([-1, -3]))            # 1
